<Project Sdk="Microsoft.NET.Sdk">
  <!-- Compile oracle corpus of the Reorganize feature: members in the order nobody would choose. Must build, and
       Program.cs prints the values of all statics and instance fields so the behaviour can be compared after reorganizing. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Oracle.Reorganize</RootNamespace>
    <NoWarn>$(NoWarn);CS0169;CS0414;CS0649;CS0067;CS0108;CS0618;CS8618;CS1591</NoWarn>
  </PropertyGroup>
</Project>
