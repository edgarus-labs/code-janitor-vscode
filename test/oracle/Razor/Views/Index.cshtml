@model List<Item>
@{
    ViewData["Title"]="Items";
}
<h1>@ViewData["Title"]</h1>
@if(Model.Count==0){<p>No items</p>}else{
<ul>
@foreach(var item in Model){
<li class="@(item.Active?"on":"off")">@item.Name</li>
}
</ul>
}
@switch(Model.Count){
case 0:
<p>none</p>
break;
default:
<p>some: @Fmt(Model.Count)</p>
break;
}
@try{
var first=Model.First();
<p>@first.Name</p>
}catch(InvalidOperationException){
<p>empty</p>
}
@section Scripts{
<script>var config = { items: @Model.Count };</script>
}
@functions{
string Fmt(int count){if(count>1){return count+" items";}return "one item";}
}
